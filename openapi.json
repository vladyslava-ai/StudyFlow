    "/api/stats/week": {
      "get": {
        "tags": [
          "Статистика"
        ],
        "summary": "Підсумки за останні 7 днів",
        "description": "Загальний час, серія днів поспіль, хвилини за днями та прогрес по предметах.",
        "operationId": "week_stats_api_stats_week_get",
