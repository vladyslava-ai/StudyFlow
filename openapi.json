  "components": {
    "schemas": {
      "DayStat": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "minutes": {
            "type": "integer",
            "title": "Minutes"
          }
        },
        "type": "object",
        "required": [
          "date",
          "minutes"
        ],
        "title": "DayStat"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "examples": [
              "Предмет не знайдено"
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SessionIn": {
        "properties": {
          "subject_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Subject Id",
            "description": "Ідентифікатор предмета"
          },
          "minutes": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 1.0,
            "title": "Minutes",
            "description": "Тривалість у хвилинах"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "Що вивчили, за бажанням"
          },
          "studied_on": {
            "type": "string",
            "format": "date",
            "title": "Studied On",
            "description": "Дата заняття, за замовчуванням сьогодні"
          }
        },
        "type": "object",
        "required": [
          "subject_id",
          "minutes"
        ],
        "title": "SessionIn",
        "examples": [
          {
            "minutes": 45,
            "note": "Цикли та функції",
            "studied_on": "2026-11-06",
            "subject_id": 1
          }
        ]
      },
      "SessionOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "subject_id": {
            "type": "integer",
            "title": "Subject Id"
          },
          "minutes": {
            "type": "integer",
            "title": "Minutes"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "studied_on": {
            "type": "string",
            "format": "date",
            "title": "Studied On"
          }
        },
        "type": "object",
        "required": [
          "id",
          "subject_id",
          "minutes",
          "studied_on"
        ],
        "title": "SessionOut",
        "examples": [
          {
            "id": 12,
            "minutes": 45,
            "note": "Цикли та функції",
            "studied_on": "2026-11-06",
            "subject_id": 1
          }
        ]
      },
      "SubjectIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name",
            "description": "Назва предмета"
          },
          "goal_minutes": {
            "type": "integer",
            "maximum": 6000.0,
            "minimum": 10.0,
            "title": "Goal Minutes",
            "description": "Тижнева ціль у хвилинах"
          }
        },
        "type": "object",
        "required": [
          "name",
          "goal_minutes"
        ],
        "title": "SubjectIn",
        "examples": [
          {
            "goal_minutes": 120,
            "name": "Tableau"
          }
        ]
      },
      "SubjectOut": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name",
            "description": "Назва предмета"
          },
          "goal_minutes": {
            "type": "integer",
            "maximum": 6000.0,
            "minimum": 10.0,
            "title": "Goal Minutes",
            "description": "Тижнева ціль у хвилинах"
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "examples": [
              1
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "goal_minutes",
          "id"
        ],
        "title": "SubjectOut",
        "examples": [
          {
            "goal_minutes": 120,
            "id": 5,
            "name": "Tableau"
          }
        ]
      },
      "SubjectStat": {
        "properties": {
          "subject_id": {
            "type": "integer",
            "title": "Subject Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "goal_minutes": {
            "type": "integer",
            "title": "Goal Minutes"
          },
          "minutes": {
            "type": "integer",
            "title": "Minutes"
          },
          "goal_reached": {
            "type": "boolean",
            "title": "Goal Reached"
          }
        },
        "type": "object",
        "required": [
          "subject_id",
          "name",
          "goal_minutes",
          "minutes",
          "goal_reached"
        ],
        "title": "SubjectStat"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WeekStats": {
        "properties": {
          "total_minutes": {
            "type": "integer",
            "title": "Total Minutes",
            "description": "Скільки хвилин навчання за останні 7 днів"
          },
          "streak_days": {
            "type": "integer",
            "title": "Streak Days",
            "description": "Скільки днів поспіль були заняття"
          },
          "per_day": {
            "items": {
              "$ref": "#/components/schemas/DayStat"
            },
            "type": "array",
            "title": "Per Day",
            "description": "Хвилини за днями, від найстарішого до сьогодні"
          },
          "per_subject": {
            "items": {
              "$ref": "#/components/schemas/SubjectStat"
            },
            "type": "array",
            "title": "Per Subject",
            "description": "Прогрес по кожному предмету"
          }
        },
        "type": "object",
        "required": [
          "total_minutes",
          "streak_days",
          "per_day",
          "per_subject"
        ],
        "title": "WeekStats"
      }
    }
  },
  "tags": [
    {
      "name": "Предмети",
      "description": "Створення, перегляд, зміна й видалення предметів"
