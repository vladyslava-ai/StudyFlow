# Скопіюйте цей файл як .env і вставте свій рядок підключення з Supabase:
# кнопка Connect -> Direct -> Connection method: Session pooler -> URI.
# Замініть [YOUR-PASSWORD] на пароль бази. Якщо в паролі є спецсимволи (@ / : # ?),
# їх треба закодувати (наприклад, @ -> %40).
DATABASE_URL=postgresql://postgres.xxxxxxxx:ВАШ_ПАРОЛЬ@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Адреси сайтів, яким дозволено звертатися до API (через кому)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5500
