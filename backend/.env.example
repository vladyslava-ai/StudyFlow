# Скопіюйте цей файл як .env та вкажіть власні параметри підключення до Supabase.
# Supabase: Connect -> Direct -> Session pooler -> URI.
# Замініть YOUR_PASSWORD на пароль бази даних.
# Спеціальні символи в паролі потрібно URL-кодувати.

DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Адреси Frontend, яким дозволено звертатися до API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5500
