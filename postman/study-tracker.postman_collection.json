    {
      "name": "9. Статистика за тиждень",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Є 7 днів і підсумки', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.per_day).to.have.lengthOf(7);",
              "  pm.expect(body.total_minutes).to.be.at.least(60);",
              "  pm.expect(body.streak_days).to.be.at.least(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
