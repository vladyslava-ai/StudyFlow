{
  "info": {
    "_postman_id": "8586f352-6332-5ade-8fe3-0b80ba597971",
    "name": "Трекер навчання API",
    "description": "Колекція запитів до REST API трекера навчання (лабораторна №3). Запити виконуються по порядку й перевіряють відповіді автотестами: Collection Runner покаже, скільки пройшло.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Перевірка сервера",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('База відповідає', () => pm.expect(pm.response.json().database).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Сервер працює й база даних доступна."
      }
    },
    {
      "name": "2. Створити предмет",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Є id, назва й ціль', () => {",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body.name).to.eql('Postman тест');",
              "  pm.expect(body.goal_minutes).to.eql(120);",
              "});",
              "pm.collectionVariables.set('subjectId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/subjects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "subjects"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman тест\",\n  \"goal_minutes\": 120\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Створює предмет. Його id зберігається в змінній subjectId для наступних запитів."
      }
    },
    {
      "name": "3. Список предметів",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Масив містить створений предмет', () => {",
              "  const id = Number(pm.collectionVariables.get('subjectId'));",
              "  pm.expect(pm.response.json().some(s => s.id === id)).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/subjects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "subjects"
          ]
        }
      }
    },
    {
      "name": "4. Отримати предмет за id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Назва збігається', () => pm.expect(pm.response.json().name).to.eql('Postman тест'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/subjects/{{subjectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "subjects",
            "{{subjectId}}"
          ]
        }
      }
    },
    {
      "name": "5. Оновити предмет",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Дані оновлено', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.name).to.eql('Postman тест (оновлено)');",
              "  pm.expect(body.goal_minutes).to.eql(180);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/subjects/{{subjectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "subjects",
            "{{subjectId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman тест (оновлено)\",\n  \"goal_minutes\": 180\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Додати сесію",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Сесія належить предмету', () => {",
              "  pm.expect(body.subject_id).to.eql(Number(pm.collectionVariables.get('subjectId')));",
              "  pm.expect(body.minutes).to.eql(45);",
              "  pm.expect(body.studied_on).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "});",
              "pm.collectionVariables.set('sessionId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sessions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject_id\": {{subjectId}},\n  \"minutes\": 45,\n  \"note\": \"Перший запит у Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Дату можна не вказувати, тоді береться сьогодні."
      }
    },
    {
      "name": "7. Сесії предмета (фільтр)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Усі сесії належать вибраному предмету', () => {",
              "  const list = pm.response.json();",
              "  pm.expect(list.length).to.be.above(0);",
              "  list.forEach(s => pm.expect(s.subject_id).to.eql(Number(pm.collectionVariables.get('subjectId'))));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sessions?subject_id={{subjectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sessions"
          ],
          "query": [
            {
              "key": "subject_id",
              "value": "{{subjectId}}"
            }
          ]
        },
        "description": "Параметри запиту: subject_id, date_from, date_to, limit, offset."
      }
    },
    {
      "name": "8. Оновити сесію",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Тривалість змінено', () => pm.expect(pm.response.json().minutes).to.eql(60));"
            ]
          }
        }
